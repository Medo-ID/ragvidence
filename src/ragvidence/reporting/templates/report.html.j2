<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>RAGvidence Report</title>

  <style>
    :root {
      color-scheme: light;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #172033;
      background: #eef2f7;
      font-synthesis: none;
      --ink: #172033;
      --muted: #637083;
      --line: #dfe5ee;
      --surface: #ffffff;
      --surface-soft: #f7f9fc;
      --navy: #111c37;
      --violet: #6941c6;
      --violet-soft: #f0ebff;
      --cyan: #087f8c;
      --cyan-soft: #e5f7f8;
      --green: #147a4b;
      --green-soft: #e9f7ef;
      --red: #b42318;
      --red-soft: #fff0ee;
      --amber: #9a6700;
      --amber-soft: #fff7df;
      --shadow: 0 16px 40px rgba(23, 32, 51, 0.08);
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      line-height: 1.55;
      background:
        radial-gradient(circle at 10% 0%, rgba(105, 65, 198, 0.10), transparent 30rem),
        radial-gradient(circle at 90% 6%, rgba(8, 127, 140, 0.10), transparent 26rem),
        #eef2f7;
    }

    main {
      width: min(1180px, calc(100% - 32px));
      margin: 32px auto 64px;
    }

    h1, h2, h3, h4, p { margin-top: 0; }
    h1 { margin-bottom: 8px; font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.05; letter-spacing: -0.045em; }
    h2 { margin-bottom: 6px; font-size: 1.35rem; letter-spacing: -0.02em; }
    h3 { margin-bottom: 4px; font-size: 1.02rem; }
    h4 { margin-bottom: 6px; font-size: 0.95rem; }

    code {
      padding: 2px 6px;
      border-radius: 5px;
      background: #edf1f7;
      color: #33415c;
      font-size: 0.88em;
      overflow-wrap: anywhere;
    }

    .hero {
      position: relative;
      overflow: hidden;
      padding: clamp(28px, 6vw, 56px);
      border-radius: 22px;
      color: #fff;
      background: linear-gradient(135deg, #101a34 0%, #242657 56%, #164a57 100%);
      box-shadow: 0 24px 60px rgba(17, 28, 55, 0.22);
    }

    .hero::after {
      content: "";
      position: absolute;
      width: 280px;
      height: 280px;
      right: -90px;
      top: -130px;
      border-radius: 50%;
      background: linear-gradient(135deg, rgba(157, 117, 255, 0.55), rgba(45, 212, 191, 0.35));
      filter: blur(4px);
    }

    .hero > * { position: relative; z-index: 1; }

    .eyebrow {
      margin-bottom: 14px;
      color: #b9f5ef;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.13em;
      text-transform: uppercase;
    }

    .hero-copy { max-width: 720px; color: #dbe5f5; font-size: 1.05rem; }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 20px;
      margin-top: 26px;
      color: #cbd7e9;
      font-size: 0.84rem;
    }

    section {
      margin-top: 24px;
      padding: clamp(20px, 4vw, 30px);
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .section-heading {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 22px;
    }

    .section-heading p { margin-bottom: 0; color: var(--muted); }

    .label {
      display: inline-flex;
      align-items: center;
      min-height: 26px;
      padding: 4px 9px;
      border-radius: 999px;
      background: var(--violet-soft);
      color: var(--violet);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .label.intervention { background: var(--cyan-soft); color: var(--cyan); }

    .metric-grid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 12px;
    }

    .metric-card {
      min-height: 110px;
      padding: 16px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: linear-gradient(180deg, #fff, var(--surface-soft));
    }

    .metric-card.featured {
      border-color: #cfc2f7;
      background: linear-gradient(145deg, #f7f3ff, #eef9fa);
    }

    .metric-label {
      display: block;
      margin-bottom: 11px;
      color: var(--muted);
      font-size: 0.72rem;
      font-weight: 750;
      letter-spacing: 0.055em;
      text-transform: uppercase;
    }

    .metric-value {
      display: block;
      font-size: 1.25rem;
      font-weight: 800;
      line-height: 1.25;
      overflow-wrap: anywhere;
    }

    .metric-detail { color: var(--muted); font-size: 0.78rem; }

    .pass { color: var(--green); }
    .failure { color: var(--red); }
    .neutral { color: var(--muted); }

    .callout-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 18px;
    }

    .callout {
      padding: 16px 18px;
      border-left: 4px solid var(--violet);
      border-radius: 9px;
      background: var(--surface-soft);
    }

    .callout p:last-child { margin-bottom: 0; }
    .callout.full { grid-column: 1 / -1; }
    .callout.warning { border-left-color: var(--amber); background: var(--amber-soft); }
    .callout.positive { border-left-color: var(--green); background: var(--green-soft); }
    .callout.negative { border-left-color: var(--red); background: var(--red-soft); }

    .question-list { display: grid; gap: 14px; }

    .question-card {
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: #fff;
    }

    .question-card.success { border-left: 5px solid var(--green); }
    .question-card.unsuccessful { border-left: 5px solid var(--red); }
    .question-card.unanswerable { border-left: 5px solid #8995a8; }

    .question-header {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      padding: 17px 18px;
      background: var(--surface-soft);
    }

    .question-header p { margin-bottom: 0; color: var(--muted); font-size: 0.82rem; }

    .status {
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      padding: 5px 10px;
      border-radius: 999px;
      font-size: 0.74rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .status.success { color: var(--green); background: var(--green-soft); }
    .status.failure { color: var(--red); background: var(--red-soft); }
    .status.neutral { color: #586579; background: #e9edf3; }

    .question-metrics {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1px;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      background: var(--line);
    }

    .question-metric { padding: 13px 16px; background: #fff; }
    .question-metric .metric-label { margin-bottom: 5px; }

    details { background: #fff; }

    summary {
      padding: 14px 18px;
      color: #38465b;
      cursor: pointer;
      font-weight: 750;
      list-style-position: inside;
    }

    summary:hover { background: #fafbfe; }

    .hits { display: grid; gap: 10px; padding: 0 18px 18px; }

    .hit {
      padding: 15px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--surface-soft);
    }

    .hit-heading {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
    }

    .rank {
      display: inline-block;
      margin-right: 6px;
      padding: 2px 7px;
      border-radius: 6px;
      color: var(--violet);
      background: var(--violet-soft);
      font-size: 0.74rem;
      font-weight: 800;
    }

    .score { color: var(--muted); font-size: 0.82rem; white-space: nowrap; }
    .evidence { margin: 7px 0; color: #43516a; font-size: 0.82rem; }
    .preview { margin-bottom: 0; color: #354258; white-space: pre-wrap; overflow-wrap: anywhere; }

    .table-wrapper { overflow-x: auto; border: 1px solid var(--line); border-radius: 11px; }

    table { width: 100%; border-collapse: collapse; }

    th, td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--line);
      text-align: left;
      vertical-align: top;
    }

    th {
      color: #4f5d73;
      background: var(--surface-soft);
      font-size: 0.73rem;
      letter-spacing: 0.045em;
      text-transform: uppercase;
    }

    tr:last-child td { border-bottom: 0; }

    .change {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 999px;
      font-size: 0.74rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .change.fail_to_pass { color: var(--green); background: var(--green-soft); }
    .change.pass_to_fail { color: var(--red); background: var(--red-soft); }
    .change.pass_to_pass { color: var(--cyan); background: var(--cyan-soft); }
    .change.fail_to_fail { color: var(--amber); background: var(--amber-soft); }

    .metadata-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px 28px;
      margin: 0;
    }

    .metadata-grid div { min-width: 0; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
    .metadata-grid dt { color: var(--muted); font-size: 0.76rem; font-weight: 750; text-transform: uppercase; }
    .metadata-grid dd { margin: 4px 0 0; overflow-wrap: anywhere; }

    .limitations { margin-bottom: 0; padding-left: 20px; color: #46546a; }
    .limitations li + li { margin-top: 8px; }

    .footer {
      margin-top: 22px;
      color: var(--muted);
      font-size: 0.78rem;
      text-align: center;
    }

    @media (max-width: 900px) {
      .metric-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .question-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 620px) {
      main { width: min(100% - 20px, 1180px); margin-top: 10px; }
      .hero, section { border-radius: 13px; }
      .metric-grid, .callout-grid, .metadata-grid { grid-template-columns: 1fr; }
      .question-header, .hit-heading, .section-heading { flex-direction: column; }
      .question-metrics { grid-template-columns: 1fr; }
      .callout.full { grid-column: auto; }
    }

    @media print {
      @page { margin: 12mm; }
      body { background: #fff; color: #000; }
      main { width: 100%; margin: 0; }
      .hero { padding: 24px; color: #fff; box-shadow: none; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
      section { margin-top: 14px; padding: 18px; box-shadow: none; break-inside: avoid; }
      .question-card, .hit, tr { break-inside: avoid; }
      details > * { display: block; }
      summary { list-style: none; }
    }
  </style>
</head>

<body>
  {% macro display_metric(value, digits=3) -%}
    {%- if value is none -%}
      N/A
    {%- else -%}
      {{ ("%." ~ digits ~ "f") | format(value) }}
    {%- endif -%}
  {%- endmacro %}

  {% macro display_percent(value) -%}
    {%- if value is none -%}
      N/A
    {%- else -%}
      {{ "%.1f%%" | format(value * 100) }}
    {%- endif -%}
  {%- endmacro %}

  {% macro optional_value(value, fallback="Not configured") -%}
    {%- if value is none -%}{{ fallback }}{%- else -%}{{ value }}{%- endif -%}
  {%- endmacro %}

  {% macro status_badge(value) -%}
    {%- if value is none -%}
      <span class="status neutral">Not applicable</span>
    {%- elif value -%}
      <span class="status success">Sufficient evidence</span>
    {%- else -%}
      <span class="status failure">Insufficient evidence</span>
    {%- endif -%}
  {%- endmacro %}

  {% macro evaluation_summary(evaluation, label, label_class="") -%}
    <section>
      <div class="section-heading">
        <div>
          <h2>{{ label }} summary</h2>
          <p>{{ evaluation.manifest.config.name }}</p>
        </div>
        <span class="label {{ label_class }}">{{ label }}</span>
      </div>

      <div class="metric-grid">
        <div class="metric-card featured">
          <span class="metric-label">Success rate</span>
          <span class="metric-value">{{ display_percent(evaluation.summary.sufficient_evidence_rate) }}</span>
          <span class="metric-detail">All required evidence retrieved</span>
        </div>
        <div class="metric-card">
          <span class="metric-label">Successful</span>
          <span class="metric-value">{{ evaluation.summary.successful }} / {{ evaluation.summary.answerable }}</span>
          <span class="metric-detail">Answerable questions</span>
        </div>
        <div class="metric-card">
          <span class="metric-label">Strategy</span>
          <span class="metric-value">{{ evaluation.manifest.config.strategy | upper }}</span>
        </div>
        <div class="metric-card">
          <span class="metric-label">Representation</span>
          <span class="metric-value">{{ evaluation.manifest.config.representation | replace("_", " ") | title }}</span>
        </div>
        <div class="metric-card">
          <span class="metric-label">Retrieval depth</span>
          <span class="metric-value">k = {{ evaluation.manifest.config.k }}</span>
        </div>
        <div class="metric-card">
          <span class="metric-label">Index time</span>
          <span class="metric-value">{{ display_metric(evaluation.manifest.index_time_ms, 1) }} ms</span>
        </div>
      </div>

      {% if evaluation.manifest.warnings %}
        <div class="callout warning full">
          <h3>Run warnings</h3>
          <ul class="limitations">
            {% for warning in evaluation.manifest.warnings %}<li>{{ warning }}</li>{% endfor %}
          </ul>
        </div>
      {% endif %}
    </section>
  {%- endmacro %}

  {% macro question_results(evaluation, label, label_class="") -%}
    <section>
      <div class="section-heading">
        <div>
          <h2>{{ label }} question results</h2>
          <p>Evidence-level metrics and ranked retrieval results for every reviewed question.</p>
        </div>
        <span class="label {{ label_class }}">{{ evaluation.questions | length }} questions</span>
      </div>

      <div class="question-list">
        {% for question in evaluation.questions %}
          <article class="question-card {% if question.sufficient_evidence is none %}unanswerable{% elif question.sufficient_evidence %}success{% else %}unsuccessful{% endif %}">
            <div class="question-header">
              <div>
                <h3>{{ question.question_id }}</h3>
                <p>
                  Split: {{ question.split | title }} ·
                  {% if question.answerable %}Answerable{% else %}Unanswerable{% endif %} ·
                  Required evidence:
                  {% if question.required_evidence_ids %}
                    {{ question.required_evidence_ids | join(", ") }}
                  {% else %}
                    None
                  {% endif %}
                </p>
              </div>
              {{ status_badge(question.sufficient_evidence) }}
            </div>

            <div class="question-metrics">
              <div class="question-metric">
                <span class="metric-label">Evidence coverage</span>
                <strong>{{ display_percent(question.evidence_coverage) }}</strong>
              </div>
              <div class="question-metric">
                <span class="metric-label">First relevant rank</span>
                <strong>{{ optional_value(question.first_relevant_rank, "N/A") }}</strong>
              </div>
              <div class="question-metric">
                <span class="metric-label">Reciprocal rank</span>
                <strong>{{ display_metric(question.reciprocal_rank) }}</strong>
              </div>
              <div class="question-metric">
                <span class="metric-label">Precision@k</span>
                <strong>{{ display_metric(question.precision_at_k) }}</strong>
              </div>
              <div class="question-metric">
                <span class="metric-label">Retrieved hits</span>
                <strong>{{ question.hits | length }}</strong>
              </div>
            </div>

            <details>
              <summary>Inspect ranked evidence ({{ question.hits | length }} hits)</summary>
              <div class="hits">
                {% for hit in question.hits %}
                  <article class="hit">
                    <div class="hit-heading">
                      <h4><span class="rank">#{{ hit.rank }}</span>{{ hit.source_unit_id }}</h4>
                      <span class="score">Score {{ display_metric(hit.score, 4) }}</span>
                    </div>
                    <p class="evidence">
                      <strong>Evidence IDs:</strong>
                      {% if hit.evidence_ids %}{{ hit.evidence_ids | join(", ") }}{% else %}None{% endif %}
                    </p>
                    <p class="preview">{{ hit.preview }}</p>
                  </article>
                {% else %}
                  <p class="neutral">No results were retrieved for this question.</p>
                {% endfor %}
              </div>
            </details>
          </article>
        {% else %}
          <p class="neutral">This evaluation contains no question results.</p>
        {% endfor %}
      </div>
    </section>
  {%- endmacro %}

  {% macro reproducibility(evaluation, label) -%}
    <div>
      <h3>{{ label }}</h3>
      <dl class="metadata-grid">
        <div><dt>Run ID</dt><dd><code>{{ evaluation.manifest.run_id }}</code></dd></div>
        <div><dt>Run created</dt><dd>{{ evaluation.manifest.created_at }}</dd></div>
        <div><dt>Dataset hash</dt><dd><code>{{ evaluation.manifest.dataset_hash }}</code></dd></div>
        <div><dt>Product version</dt><dd>{{ evaluation.manifest.product_version }}</dd></div>
        <div><dt>Python version</dt><dd>{{ evaluation.manifest.python_version }}</dd></div>
        <div><dt>Platform</dt><dd>{{ evaluation.manifest.platform }}</dd></div>
        <div><dt>Model</dt><dd>{{ optional_value(evaluation.manifest.config.model) }}</dd></div>
        <div><dt>Provider</dt><dd>{{ optional_value(evaluation.manifest.config.provider) }}</dd></div>
      </dl>
    </div>
  {%- endmacro %}

  <main>
    <header class="hero">
      <p class="eyebrow">Local retrieval diagnostics · Evidence-first evaluation</p>
      <h1>RAGvidence</h1>
      <p class="hero-copy">
        A reproducible report showing whether retrieval returned all evidence required to answer each reviewed question.
      </p>
      <div class="hero-meta">
        <span>Generated {{ report.generated_at }}</span>
        <span>Schema v{{ report.schema_version }}</span>
        <span>Dataset <code>{{ report.baseline.manifest.dataset_hash }}</code></span>
      </div>
    </header>

    {{ evaluation_summary(report.baseline, "Baseline") }}

    {% if report.intervention is not none %}
      {{ evaluation_summary(report.intervention, "Intervention", "intervention") }}
    {% endif %}

    {% if report.comparison is not none %}
      <section>
        <div class="section-heading">
          <div>
            <h2>Change analysis</h2>
            <p>Question-level movement from the baseline to the intervention.</p>
          </div>
          <span class="label intervention">Comparison</span>
        </div>

        <div class="metric-grid">
          <div class="metric-card">
            <span class="metric-label">Fail → Pass</span>
            <span class="metric-value pass">{{ report.comparison.summary.fail_to_pass }}</span>
            <span class="metric-detail">Recovered questions</span>
          </div>
          <div class="metric-card">
            <span class="metric-label">Pass → Fail</span>
            <span class="metric-value failure">{{ report.comparison.summary.pass_to_fail }}</span>
            <span class="metric-detail">Regressions to inspect</span>
          </div>
          <div class="metric-card">
            <span class="metric-label">Pass → Pass</span>
            <span class="metric-value">{{ report.comparison.summary.pass_to_pass }}</span>
            <span class="metric-detail">Stable successes</span>
          </div>
          <div class="metric-card">
            <span class="metric-label">Fail → Fail</span>
            <span class="metric-value neutral">{{ report.comparison.summary.fail_to_fail }}</span>
            <span class="metric-detail">Persistent failures</span>
          </div>
        </div>

        <div class="table-wrapper" style="margin-top: 18px;">
          <table>
            <thead><tr><th>Question</th><th>Classification</th></tr></thead>
            <tbody>
              {% for change in report.comparison.changes %}
                <tr>
                  <td>{{ change.question_id }}</td>
                  <td>
                    {% if change.classification is none %}
                      <span class="change">Not applicable</span>
                    {% else %}
                      <span class="change {{ change.classification }}">{{ change.classification | replace("_", " ") | title }}</span>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>
    {% endif %}

    {% if report.diagnosis is not none %}
      <section>
        <div class="section-heading">
          <div><h2>Evidence-backed diagnosis</h2><p>What changed, what the evidence supports, and what to test next.</p></div>
          <span class="label">{{ report.diagnosis.confidence }} confidence</span>
        </div>
        <div class="callout-grid">
          <div class="callout full {% if report.comparison.summary.pass_to_fail %}negative{% else %}positive{% endif %}">
            <h3>Observed pattern</h3><p>{{ report.diagnosis.pattern }}</p>
          </div>
          <div class="callout"><h3>Evidence</h3><p>{{ report.diagnosis.evidence }}</p></div>
          <div class="callout"><h3>Recommended next experiment</h3><p>{{ report.diagnosis.next_experiment }}</p></div>
          <div class="callout warning full"><h3>Diagnostic limit</h3><p>{{ report.diagnosis.limit }}</p></div>
        </div>
      </section>
    {% endif %}

    {{ question_results(report.baseline, "Baseline") }}

    {% if report.intervention is not none %}
      {{ question_results(report.intervention, "Intervention", "intervention") }}
    {% endif %}

    <section>
      <div class="section-heading">
        <div><h2>Reproducibility</h2><p>Run identity and environment details needed to interpret or repeat this experiment.</p></div>
        <span class="label">Run metadata</span>
      </div>
      <div class="callout-grid">
        {{ reproducibility(report.baseline, "Baseline run") }}
        {% if report.intervention is not none %}
          {{ reproducibility(report.intervention, "Intervention run") }}
        {% endif %}
      </div>
    </section>

    <section>
      <div class="section-heading">
        <div><h2>Limitations</h2><p>Read these constraints before generalizing the result.</p></div>
        <span class="label">Scope</span>
      </div>
      <ul class="limitations">
        {% for limitation in report.limitations %}<li>{{ limitation }}</li>{% endfor %}
      </ul>
    </section>

    <p class="footer">Generated locally by RAGvidence · No source documents or credentials are embedded beyond the recorded previews.</p>
  </main>
</body>
</html>
