{% from '_labels.html.j2' import outcome, state, scroll_start %}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>RAGvidence comparison · {{ report.input_name }}</title>
<meta name="color-scheme" content="dark">
<style>{% include '_styles.css.j2' %}</style></head><body><a class="skip-link" href="#summary">Skip to report summary</a><main>
{% set report_type = "comparison / techniques" %}
{% include "_toolbar.html.j2" %}
<header id="summary"><p class="eyebrow">FROZEN INPUTS / COMPARISON</p><h1>Technique comparison</h1><p class="input-name">{{ report.input_name }}</p>
<p>{{ state(report.state) }} · {{ report.evaluation_level | replace("_", " ") }} · Phase: {{ report.phase }}</p>
<p>Baseline: {{ report.baseline }} · Policy: {{ report.policy }}</p>
{% for observation in report.observations %}<p class="notice">{{ observation }}</p>{% endfor %}
{% if report.heldout_use %}<p>Heldout evaluation #{{ report.heldout_use.evaluation_number }} under this output root · Previously used: {{ report.heldout_use.reused }}</p>{% endif %}
</header>
<nav class="report-nav" aria-label="Report navigation"><a href="#summary">Summary</a><a href="#tradeoffs">Status &amp; resources</a>{% for pair in report.comparisons %}<a href="#pair-{{ loop.index }}">{{ pair.participant }} vs {{ pair.baseline }}</a>{% endfor %}{% for entry in report.participants %}<a href="#participant-{{ loop.index }}">{{ entry.name }}</a>{% endfor %}<a href="#limitations">Limitations</a></nav>
<section id="tradeoffs"><h2>Execution &amp; resource trade-offs</h2><p class="section-copy">Read completion status alongside quality and resource evidence. Timing covers known values only; N/A means unavailable. No automatic winner is selected.</p>
{{ scroll_start('Participant execution and resource measurements') }}<table class="tradeoffs"><caption>Recorded participant measurements</caption><thead><tr><th scope="col">Participant / status</th><th scope="col">Evidence scope</th><th scope="col">Query time, ms</th><th scope="col">Rendered context</th><th scope="col">Supplied-usage cost</th></tr></thead><tbody>
{% for entry in report.participants %}<tr><td><a href="#participant-{{ loop.index }}">{{ entry.name }}</a><br>{{ state(entry.state) }}</td>{% if entry.state == 'complete' %}<td>{{ entry.evidence_scope | replace('_', ' ') }}</td><td>{{ '%.2f' | format(entry.resources.query_ms.mean_known) if entry.resources.query_ms.mean_known is not none else 'N/A' }}<br><span class="meta">{{ entry.resources.query_ms.known_count }} known · {{ entry.resources.query_ms.missing_count }} missing</span></td><td>{{ entry.resources.context_units.mean_known if entry.resources.context_units.mean_known is not none else 'N/A' }} {{ entry.resources.context_unit or '' }}</td><td>{{ entry.usage.cost if entry.usage.cost is not none else 'N/A' }} {{ entry.usage.currency or '' }}</td>{% else %}<td colspan="4">N/A · {{ entry.error }}</td>{% endif %}</tr>{% endfor %}
</tbody></table></div></section>
{% for pair in report.comparisons %}<section id="pair-{{ loop.index }}"><h2>{{ pair.participant }} versus {{ pair.baseline }}</h2><p>{{ pair.interpretation }}</p><p>Scope: {{ pair.scope }}</p>
{% for split, scopes in pair.splits.items() %}{% for name, facts in scopes.items() %}<h3>{{ split }} / {{ name }}</h3><p>{{ facts.answerable_questions }} answerable questions · Improved {{ facts.changes.improved }} · Regressed {{ facts.changes.regressed }} · Stable pass {{ facts.changes.stable_pass }} · Stable fail {{ facts.changes.stable_fail }}</p>
<details><summary>Paired metric differences and 95% intervals · {{ split }} / {{ name }}</summary>{{ scroll_start('Paired evidence changes') }}<table><thead><tr><th>Paired change</th><th>Mean difference</th><th>95% interval</th><th>Declared groups</th></tr></thead><tbody>{% for metric, interval in facts.intervals.items() %}<tr><td>{{ metric }}</td><td>{{ interval.estimate if interval.estimate is not none else 'N/A' }}</td><td>{{ interval.lower if interval.lower is not none else 'N/A' }} to {{ interval.upper if interval.upper is not none else 'N/A' }}<br>{{ interval.note }}</td><td>{{ interval.group_count }}</td></tr>{% endfor %}</tbody></table></div></details>{% endfor %}{% endfor %}
{{ scroll_start('Question-level evidence gains and losses') }}<table><caption>Question-level changes</caption><thead><tr><th scope="col">Question / split</th><th scope="col">Outcome</th><th scope="col">Gained evidence</th><th scope="col">Lost evidence</th><th scope="col">Still missing</th></tr></thead><tbody>{% for question in pair.questions %}<tr><td>{{ question.question_id }} · {{ question.split }}</td><td>{{ state(question.change or 'N/A · unscored') }}</td><td>{{ question.gained | join(', ') or 'none' }}</td><td>{{ question.lost | join(', ') or 'none' }}</td><td>{{ question.missing | join(', ') or 'none' }}</td></tr>{% else %}<tr><td colspan="5">N/A · No scored question-level comparison.</td></tr>{% endfor %}</tbody></table></div></section>{% endfor %}
{% for entry in report.participants %}<section id="participant-{{ loop.index }}"><h2>{{ entry.name }}</h2><p>Status: {{ state(entry.state) }}</p>
{% if entry.state != 'complete' %}<p class="bad">{{ entry.error }}</p>{% else %}
<p class="meta">Strategy: {{ entry.report.manifest.config.strategy }} · k={{ entry.report.manifest.config.k }} · {{ entry.report.input.passage_count }} prepared passages</p>
<p><strong>Evidence scope: {{ entry.evidence_scope }}</strong></p>
{% for observation in entry.report.observations %}<p class="meta">{{ observation }}</p>{% endfor %}
{% if entry.summaries %}{{ scroll_start('Evidence outcomes by split and slice') }}<table><thead><tr><th>Split / slice</th><th>Sufficient / answerable</th><th>Coverage</th><th>MRR</th><th>Precision</th></tr></thead><tbody>
{% for split, scopes in entry.summaries.items() %}{% for name, summary in scopes.items() %}<tr><td>{{ split }} / {{ name }}</td><td>{{ summary.sufficient_count }} / {{ summary.answerable_questions }}</td><td>{{ summary.mean_evidence_coverage if summary.mean_evidence_coverage is not none else 'N/A' }}</td><td>{{ summary.mean_reciprocal_rank if summary.mean_reciprocal_rank is not none else 'N/A' }}</td><td>{{ summary.mean_precision_at_k if summary.mean_precision_at_k is not none else 'N/A' }}</td></tr>{% endfor %}{% endfor %}
</tbody></table></div>{% endif %}
<p>Mean query time over {{ entry.resources.query_ms.known_count }} known values: {{ '%.2f' | format(entry.resources.query_ms.mean_known) if entry.resources.query_ms.mean_known is not none else 'N/A' }} ms · {{ entry.resources.query_ms.missing_count }} missing</p>
<p>Mean rendered context: {{ entry.resources.context_units.mean_known if entry.resources.context_units.mean_known is not none else 'N/A' }} {{ entry.resources.context_unit or '' }} · Original text characters: {{ entry.resources.context_characters.mean_known if entry.resources.context_characters.mean_known is not none else 'N/A' }}</p>
<p>Supplied-usage cost estimate: {{ entry.usage.cost if entry.usage.cost is not none else 'N/A' }} {{ entry.usage.currency or '' }} · Pricing: {{ entry.usage.pricing_identity or 'unavailable' }}</p>
<details><summary>Configuration, criteria and separate timing trials</summary><pre>{{ {'config':entry.report.manifest.config,'criteria':entry.criteria,'trials':entry.trials,'repeat_rankings_changed':entry.repeat_rankings_changed} | tojson(indent=2) }}</pre></details>
<details><summary>Ranked contexts and stage evidence ({{ entry.report.questions | length }} questions)</summary>
{% for question in entry.report.questions %}<details><summary>{{ question.question_id }} · {{ question.question }}<span class="summary-metrics">{% if question.metrics %}{{ outcome(question.metrics.sufficient_evidence) }}{% else %}<span class="status muted">N/A · Unscored</span>{% endif %}<span>{{ question.context_characters }} returned text characters</span></span></summary><article><h3>{{ question.question }}</h3><p class="meta">{{ question.question_id }} · {{ question.context_characters }} returned text characters</p>
{% for observation in question.observations %}<p>{{ observation }}</p>{% endfor %}
{% if question.metrics %}<p>{{ outcome(question.metrics.sufficient_evidence) }} · Split: {{ question.metrics.split }} · Missing: {{ question.metrics.missing_evidence_ids | join(', ') or 'none' }}</p>{% endif %}
{% for hit in question.hits %}<p class="meta">Rank {{ hit.rank }}{% if hit.get('context_spans') %} · Extract {{ hit.context_part }}{% endif %} · {{ hit.source_path }} · {{ hit.location_label }} · Original characters {{ hit.start }}–{{ hit.end }}</p><pre class="passage">{{ hit.text }}</pre>{% endfor %}
<details><summary>Observed stages and scores</summary><pre>{{ question.stages | tojson(indent=2) }}</pre></details></article></details>{% endfor %}</details>
{% endif %}</section>{% endfor %}
<section id="limitations"><h2>Limitations</h2><p class="print-note">Printing includes every question, source passage and closed disclosure, including configuration and stage evidence.</p><ul>{% for value in report.limitations %}<li>{{ value }}</li>{% endfor %}</ul><p class="meta">Generated {{ report.generated_at }} · Query-stage invocation upper bound {{ report.query_call_upper_bound }}</p><details><summary>Bundled font license</summary><pre>{{ fonts.license }}</pre></details></section>
</main>{% include "_theme.js.j2" %}
</body></html>
