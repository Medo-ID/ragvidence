# Optional. Core defaults are fastembed + BAAI/bge-small-en-v1.5.
# Other values: ollama, openai_compatible.
RAGLAB_EMBEDDING_PROVIDER=fastembed
RAGLAB_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAGLAB_EMBEDDING_BASE_URL=
RAGLAB_EMBEDDING_API_KEY=

# Optional answer inspection: ollama or openai_compatible.
RAGLAB_GENERATION_PROVIDER=
RAGLAB_GENERATION_MODEL=
RAGLAB_GENERATION_BASE_URL=
RAGLAB_GENERATION_API_KEY=
