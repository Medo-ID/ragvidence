# Optional provider settings. BM25 needs no model or API key.
# Local semantic defaults are fastembed + BAAI/bge-small-en-v1.5.
# Other values: ollama, openai_compatible.
RAGVIDENCE_EMBEDDING_PROVIDER=fastembed
RAGVIDENCE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAGVIDENCE_EMBEDDING_BASE_URL=
RAGVIDENCE_EMBEDDING_API_KEY=

# Optional answer inspection: ollama or openai_compatible.
RAGVIDENCE_GENERATION_PROVIDER=
RAGVIDENCE_GENERATION_MODEL=
RAGVIDENCE_GENERATION_BASE_URL=
RAGVIDENCE_GENERATION_API_KEY=
# Optional question rewriting / model span selection (portable use: --env-file).
# RAGVIDENCE_TRANSFORM_BASE_URL=http://localhost:11434
# RAGVIDENCE_TRANSFORM_API_KEY=
